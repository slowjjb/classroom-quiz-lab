{
  "rules": {
    ".read": false,
    ".write": false,
    "v0": {
      "presence": {
        ".read": "auth != null && auth.uid === 'OaI1FCuwa7droffj277NQsvjyw52' && auth.token.firebase.sign_in_provider === 'google.com'",
        "$uid": {
          "$session": {
            ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'anonymous'",
            ".validate": "newData.hasChildren(['name', 'connectedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "connectedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "v1": {
      "questionSets": {
        ".read": "auth != null && auth.uid === 'OaI1FCuwa7droffj277NQsvjyw52' && auth.token.firebase.sign_in_provider === 'google.com'",
        ".write": "auth != null && auth.uid === 'OaI1FCuwa7droffj277NQsvjyw52' && auth.token.firebase.sign_in_provider === 'google.com'",
        "$setId": {
          ".validate": "newData.hasChildren(['title', 'createdAt', 'updatedAt', 'questions']) && newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 80 && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber() && newData.child('questions').hasChildren()",
          "title": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "sourceName": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "questions": {
            "$qid": {
              ".validate": "newData.hasChildren(['number','prompt','type','timeLimit','options','correctIndex']) && newData.child('number').isNumber() && newData.child('prompt').isString() && newData.child('timeLimit').isNumber() && newData.child('correctIndex').isNumber() && (newData.child('type').val() === 'typing' || newData.child('type').val() === 'multiple_choice')",
              "$other": {
                ".validate": true
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "v2": {
      "hostRooms": {
        "$hostUid": {
          ".read": "auth != null && auth.uid === 'OaI1FCuwa7droffj277NQsvjyw52' && auth.token.firebase.sign_in_provider === 'google.com' && $hostUid === auth.uid",
          ".write": "auth != null && auth.uid === 'OaI1FCuwa7droffj277NQsvjyw52' && auth.token.firebase.sign_in_provider === 'google.com' && $hostUid === auth.uid",
          "$code": {
            ".validate": "newData.hasChildren(['createdAt','title','state']) && newData.child('createdAt').isNumber() && newData.child('title').isString() && newData.child('title').val().length <= 80 && (newData.child('state').val() === 'lobby' || newData.child('state').val() === 'locked' || newData.child('state').val() === 'ended')",
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "rooms": {
        "$code": {
          ".read": "auth != null && auth.uid === 'OaI1FCuwa7droffj277NQsvjyw52' && auth.token.firebase.sign_in_provider === 'google.com' || (auth != null && data.child('members').child(auth.uid).child('profile').exists())",
          ".write": "auth != null && auth.uid === 'OaI1FCuwa7droffj277NQsvjyw52' && auth.token.firebase.sign_in_provider === 'google.com'",
          ".validate": "newData.hasChild('meta') && newData.child('meta').child('hostUid').val() === 'OaI1FCuwa7droffj277NQsvjyw52'",
          "meta": {
            ".read": "auth != null",
            ".validate": "newData.hasChildren(['hostUid','createdAt','state','title','mode','setTitle']) && newData.child('hostUid').val() === 'OaI1FCuwa7droffj277NQsvjyw52' && newData.child('createdAt').isNumber() && newData.child('title').isString() && newData.child('title').val().length <= 80 && (newData.child('state').val() === 'lobby' || newData.child('state').val() === 'locked' || newData.child('state').val() === 'ended') && newData.child('mode').isString() && newData.child('setTitle').isString()",
            "$other": {
              ".validate": true
            }
          },
          "members": {
            "$uid": {
              "profile": {
                ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'anonymous'",
                ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('v2/rooms/' + $code).child('meta/state').val() === 'lobby'",
                ".validate": "newData.hasChildren(['name','joinedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && newData.child('joinedAt').isNumber()",
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
                },
                "joinedAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              },
              "connections": {
                "$session": {
                  ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'anonymous' && (!newData.exists() || (root.child('v2/rooms/' + $code).child('members').child($uid).child('profile').exists() && root.child('v2/rooms/' + $code).child('meta/state').val() !== 'ended'))",
                  ".validate": "newData.isNumber()"
                }
              }
            }
          }
        }
      }
    }
  }
}
